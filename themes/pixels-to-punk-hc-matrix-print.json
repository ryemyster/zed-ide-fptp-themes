{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Pixels to Punk",
  "author": "Ryan McDonald",
  "themes": [
    {
      "name": "Pixels to Punk HC Matrix Print",
      "appearance": "dark",
      "style": {
        "background": "#031006",
        "text": "#EEFFF0",
