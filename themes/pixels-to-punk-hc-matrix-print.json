        "terminal.ansi.yellow": "#FFE875",
        "terminal.ansi.blue": "#8BD6A5",
        "terminal.ansi.magenta": "#D6FF72",
        "terminal.ansi.cyan": "#72FF9A",
        "terminal.ansi.white": "#EEFFF0",
        "terminal.ansi.bright_black": "#8EC894",
        "terminal.ansi.bright_red": "#FF7A7A",
        "terminal.ansi.bright_green": "#72FF9A",
        "terminal.ansi.bright_yellow": "#FFE875",
        "terminal.ansi.bright_blue": "#8BD6A5",
