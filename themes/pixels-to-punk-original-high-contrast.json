        "terminal.ansi.yellow": "#ffaa79",
        "terminal.ansi.blue": "#7cb6ff",
        "terminal.ansi.magenta": "#ff5eb6",
        "terminal.ansi.cyan": "#45eaff",
        "terminal.ansi.white": "#ffffff",
        "terminal.ansi.bright_black": "#b3b7d2",
        "terminal.ansi.bright_red": "#ff8c9d",
        "terminal.ansi.bright_green": "#45eaff",
