          "boolean": {
            "color": "#725F12"
          },
          "constant": {
            "color": "#725F12"
          },
          "keyword": {
            "color": "#8E3B68"
          },
          "function": {
            "color": "#006C72"
          },
          "variable": {
            "color": "#202B32"
          },
          "variable.special": {
            "color": "#7B5636"
          },
          "type": {
            "color": "#595795"
          },
          "attribute": {
            "color": "#315F8E"
          },
          "property": {
            "color": "#315F8E"
          },
          "punctuation": {
            "color": "#48545B"
          },
          "invalid": {
            "color": "#A83A4C"
          }
        }
