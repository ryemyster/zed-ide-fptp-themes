        "ghost_element.selected": "#006C7235",
        "text.muted": "#53616B",
        "text.placeholder": "#62717B",
        "text.accent": "#006C72",
        "icon.muted": "#62717B",
        "surface.background": "#E0E8D9",
        "panel.background": "#E0E8D9",
        "panel.focused_border": "#C3CFB7",
        "elevated_surface.background": "#FAFCF6",
