        "search.match_background": "#CAB75F5C",
        "error": "#A83A4C",
        "warning": "#725F12",
        "info": "#006C72",
        "hint": "#006C72",
        "success": "#33704A",
        "created": "#33704A",
        "deleted": "#A83A4C",
        "modified": "#725F12",
        "conflict": "#8E3B68",
