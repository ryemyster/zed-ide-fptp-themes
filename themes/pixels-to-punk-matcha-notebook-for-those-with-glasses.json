        "terminal.foreground": "#202B32",
        "terminal.ansi.black": "#202B32",
        "terminal.ansi.red": "#A83A4C",
        "terminal.ansi.green": "#33704A",
        "terminal.ansi.yellow": "#725F12",
        "terminal.ansi.blue": "#315F8E",
        "terminal.ansi.magenta": "#8E3B68",
        "terminal.ansi.cyan": "#006C72",
        "terminal.ansi.white": "#202B32",
        "terminal.ansi.bright_black": "#62717B",
        "terminal.ansi.bright_red": "#ad5461",
        "terminal.ansi.bright_green": "#3c7c52",
        "terminal.ansi.bright_yellow": "#846d29",
        "terminal.ansi.bright_blue": "#4872a2",
