{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Pixels to Punk",
  "author": "Ryan McDonald",
  "themes": [
    {
      "name": "Pixels to Punk Matcha Notebook for Those with Glasses",
      "appearance": "light",
      "style": {
        "background": "#F2F5EC",
        "text": "#202B32",
        "editor.background": "#F2F5EC",
        "editor.foreground": "#202B32",
        "editor.line_number": "#62717B",
        "editor.active_line_number": "#006C72",
        "editor.active_line.background": "#E7EDE0",
        "editor.gutter.background": "#F2F5EC",
        "editor.indent_guide": "#CFDBC8",
