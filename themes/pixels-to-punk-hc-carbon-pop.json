        "terminal.ansi.green": "#8ffeaa",
        "terminal.ansi.yellow": "#fde776",
        "terminal.ansi.blue": "#92bfff",
        "terminal.ansi.magenta": "#fd6acd",
        "terminal.ansi.cyan": "#27ddff",
        "terminal.ansi.white": "#f5f8ff",
