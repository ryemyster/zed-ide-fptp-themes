        "terminal.ansi.yellow": "#624a03",
        "terminal.ansi.blue": "#03499d",
        "terminal.ansi.magenta": "#6e4703",
        "terminal.ansi.cyan": "#035d52",
        "terminal.ansi.white": "#101510",
        "terminal.ansi.bright_black": "#485448",
        "terminal.ansi.bright_red": "#8e031d",
