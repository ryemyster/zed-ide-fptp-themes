{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Pixels to Punk",
  "author": "Ryan McDonald",
  "themes": [
    {
      "name": "Pixels to Punk Sepia Debugger",
      "appearance": "light",
