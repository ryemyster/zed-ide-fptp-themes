        "terminal.ansi.green": "#46522d",
        "terminal.ansi.yellow": "#785728",
        "terminal.ansi.blue": "#485b6d",
        "terminal.ansi.magenta": "#884854",
        "terminal.ansi.cyan": "#3e635c",
        "terminal.ansi.white": "#2b241b",
