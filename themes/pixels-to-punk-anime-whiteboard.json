        "element.active": "#DCE8F7",
        "element.selected": "#DCE8F7",
        "element.disabled": "#E6EDF7",
        "ghost_element.hover": "#EFF5FD",
        "ghost_element.active": "#DCE8F7",
        "ghost_element.selected": "#E6EDF7",
        "text.muted": "#505B6F",
        "text.placeholder": "#667286",
        "text.accent": "#006A86",
        "icon.muted": "#667286",
        "surface.background": "#E7EEFB",
        "panel.background": "#E7EEFB",
        "panel.focused_border": "#C7D6EC",
        "elevated_surface.background": "#FFFFFF",
        "drop_target.background": "#006A8630",
        "status_bar.background": "#E7EEFB",
        "title_bar.background": "#E7EEFB",
        "title_bar.inactive_background": "#F9FBFF",
        "toolbar.background": "#E7EEFB",
        "tab_bar.background": "#E7EEFB",
        "tab.active_background": "#F9FBFF",
        "tab.inactive_background": "#E7EEFB",
        "scrollbar.thumb.background": "#8DA0BC55",
        "scrollbar.thumb.hover_background": "#8091AA66",
