          "string": {
            "color": "#A52C48"
          },
          "title": {
            "color": "#974234"
          },
          "number": {
            "color": "#7A5200"
          },
          "boolean": {
            "color": "#785D00"
          },
          "constant": {
            "color": "#785D00"
          },
          "keyword": {
            "color": "#8F2F6E"
          },
          "function": {
            "color": "#156E78"
          },
          "variable": {
            "color": "#1B2230"
          },
          "variable.special": {
            "color": "#8A5032"
          },
          "type": {
            "color": "#5750A6"
          },
          "attribute": {
            "color": "#2D609E"
          },
          "property": {
            "color": "#2D609E"
          },
          "punctuation": {
            "color": "#485265"
          },
          "invalid": {
            "color": "#FFFFFF"
          }
        }
