{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Pixels to Punk",
  "author": "Ryan McDonald",
  "themes": [
    {
      "name": "Pixels to Punk Anime Whiteboard",
      "appearance": "light",
      "style": {
        "background": "#FFF7ED",
        "text": "#241B2F",
        "editor.background": "#F9FBFF",
        "editor.foreground": "#1B2230",
        "editor.line_number": "#667286",
        "editor.active_line_number": "#A52C68",
        "editor.active_line.background": "#EDF4FF",
        "editor.gutter.background": "#F9FBFF",
        "editor.indent_guide": "#D4DEED",
        "editor.indent_guide_active": "#8D9DB5",
        "editor.document_highlight.read_background": "#006A8630",
        "editor.document_highlight.write_background": "#A1267B28",
        "search.match_background": "#D4B75A66",
        "error": "#A52C48",
        "warning": "#7A5200",
        "info": "#156E78",
        "hint": "#006A86",
        "success": "#3A6B3F",
        "created": "#006A86",
        "deleted": "#B2304D",
        "modified": "#785D00",
        "conflict": "#B00070",
        "ignored": "#7F8799",
        "hidden": "#7F8799",
        "renamed": "#007E8C",
        "border": "#C7D6EC",
        "border.focused": "#006A86",
        "border.selected": "#006A86",
        "border.variant": "#C7D6EC",
        "element.background": "#EFF5FD",
        "element.hover": "#006A8622",
        "element.active": "#006A8655",
        "element.selected": "#006A8640",
        "element.disabled": "#E6EDF7",
        "ghost_element.hover": "#006A8618",
        "ghost_element.active": "#006A864a",
        "ghost_element.selected": "#006A8635",
        "text.muted": "#505B6F",
        "text.placeholder": "#667286",
        "text.accent": "#A52C68",
        "icon.muted": "#667286",
        "surface.background": "#E7EEFB",
        "panel.background": "#E7EEFB",
        "panel.focused_border": "#C7D6EC",
        "elevated_surface.background": "#FFFFFF",
        "drop_target.background": "#006A8630",
        "status_bar.background": "#E7EEFB",
        "title_bar.background": "#E7EEFB",
        "title_bar.inactive_background": "#F9FBFF",
        "toolbar.background": "#E7EEFB",
        "tab_bar.background": "#E7EEFB",
        "tab.active_background": "#F9FBFF",
        "tab.inactive_background": "#E7EEFB",
        "scrollbar.thumb.background": "#8DA0BC55",
        "scrollbar.thumb.hover_background": "#8091AA66",
        "scrollbar.thumb.border": "#8DA0BC55",
        "scrollbar.track.background": "#F9FBFF",
        "scrollbar.track.border": "#F9FBFF",
        "terminal.background": "#FFF7ED",
        "terminal.foreground": "#241B2F",
        "terminal.ansi.black": "#1b2230",
        "terminal.ansi.red": "#a52c48",
        "terminal.ansi.green": "#3a6b3f",
        "terminal.ansi.yellow": "#7a5200",
        "terminal.ansi.blue": "#2f5f8f",
        "terminal.ansi.magenta": "#8f2f6e",
        "terminal.ansi.cyan": "#156e78",
        "terminal.ansi.white": "#241b2f",
        "terminal.ansi.bright_black": "#5a6578",
        "terminal.ansi.bright_red": "#8f243f",
        "terminal.ansi.bright_green": "#2f5f34",
        "terminal.ansi.bright_yellow": "#684400",
        "terminal.ansi.bright_blue": "#244d78",
        "terminal.ansi.bright_magenta": "#76245d",
        "terminal.ansi.bright_cyan": "#0c5d66",
        "terminal.ansi.bright_white": "#241b2f",
