            "color": "#785D00"
          },
          "boolean": {
            "color": "#785D00"
          },
          "constant": {
            "color": "#785D00"
          },
          "keyword": {
            "color": "#A1267B"
          },
          "function": {
            "color": "#006A86"
          },
          "variable": {
            "color": "#1B2230"
          },
          "variable.special": {
            "color": "#8A5032"
          },
          "type": {
            "color": "#5750A6"
          },
          "attribute": {
            "color": "#2D609E"
          },
          "property": {
            "color": "#2D609E"
          },
          "punctuation": {
            "color": "#485265"
          },
          "invalid": {
            "color": "#FFFFFF"
          }
        }
