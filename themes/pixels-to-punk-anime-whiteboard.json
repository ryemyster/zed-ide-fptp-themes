{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Pixels to Punk",
  "author": "Ryan McDonald",
  "themes": [
    {
      "name": "Pixels to Punk Anime Whiteboard",
      "appearance": "light",
      "style": {
        "background": "#F9FBFF",
        "text": "#1B2230",
        "editor.background": "#F9FBFF",
        "editor.foreground": "#1B2230",
        "editor.line_number": "#667286",
        "editor.active_line_number": "#006A86",
        "editor.active_line.background": "#EDF4FF",
        "editor.gutter.background": "#F9FBFF",
        "editor.indent_guide": "#D4DEED",
