        "scrollbar.track.border": "#F9FBFF",
        "terminal.background": "#F9FBFF",
        "terminal.foreground": "#1B2230",
        "terminal.ansi.black": "#1B2230",
        "terminal.ansi.red": "#B2304D",
        "terminal.ansi.green": "#006A86",
        "terminal.ansi.yellow": "#785D00",
        "terminal.ansi.blue": "#2D609E",
        "terminal.ansi.magenta": "#A1267B",
        "terminal.ansi.cyan": "#006A86",
        "terminal.ansi.white": "#1B2230",
        "terminal.ansi.bright_black": "#667286",
        "terminal.ansi.bright_red": "#C95368",
        "terminal.ansi.bright_green": "#0088A5",
        "terminal.ansi.bright_yellow": "#947300",
        "terminal.ansi.bright_blue": "#477BBE",
        "terminal.ansi.bright_magenta": "#B84C98",
        "terminal.ansi.bright_cyan": "#0088A5",
        "terminal.ansi.bright_white": "#FFFFFF",
