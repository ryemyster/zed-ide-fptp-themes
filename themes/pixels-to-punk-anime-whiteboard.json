        "editor.document_highlight.read_background": "#006A8630",
        "editor.document_highlight.write_background": "#A1267B28",
        "search.match_background": "#D4B75A66",
        "error": "#B2304D",
        "warning": "#785D00",
        "info": "#006A86",
        "hint": "#006A86",
        "success": "#006A86",
        "created": "#006A86",
        "deleted": "#B2304D",
        "modified": "#785D00",
        "conflict": "#A1267B",
        "ignored": "#667286",
        "hidden": "#667286",
        "renamed": "#006A86",
