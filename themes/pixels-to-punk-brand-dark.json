{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Pixels to Punk",
  "author": "Ryan McDonald",
  "themes": [
    {
      "name": "Pixels to Punk Brand Dark",
      "appearance": "dark",
      "style": {
        "background": "#1a0a2e",
        "text": "#E8E8FF",
        "editor.background": "#1a0a2e",
        "editor.foreground": "#E8E8FF",
        "editor.line_number": "#6A5ACD",
        "editor.active_line_number": "#FF1493",
        "editor.active_line.background": "#2D1B4E",
        "editor.gutter.background": "#1a0a2e",
        "editor.indent_guide": "#3D2B5E",
        "editor.indent_guide_active": "#6A5ACD",
        "editor.document_highlight.read_background": "#00CED122",
        "editor.document_highlight.write_background": "#FF149322",
        "search.match_background": "#FF1493AA",
        "error": "#FF6347",
        "warning": "#FFD700",
        "info": "#00CED1",
        "hint": "#00CED1",
        "success": "#00FF41",
        "created": "#00FF41",
        "deleted": "#FF6347",
        "modified": "#FFD700",
        "conflict": "#FF1493",
        "ignored": "#6A5ACD",
        "hidden": "#6A5ACD",
        "renamed": "#00CED1",
        "border": "#3D2B5E",
