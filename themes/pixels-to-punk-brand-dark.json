          {
            "cursor": "#00CED1",
            "selection": "#00CED155",
            "background": "#00CED1"
          }
        ],
        "syntax": {
          "comment": {
            "color": "#9D8FBD",
            "font_style": "italic"
          },
          "string": {
            "color": "#00FF41"
          },
          "title": {
            "color": "#00FF41"
          },
          "number": {
            "color": "#FFD700"
          },
          "boolean": {
            "color": "#FFD700"
          },
          "constant": {
            "color": "#FFD700"
          },
          "keyword": {
            "color": "#FF1493"
          },
          "function": {
            "color": "#00CED1"
          },
          "variable": {
            "color": "#E8E8FF"
          },
          "variable.special": {
            "color": "#FF8C00"
          },
          "type": {
            "color": "#00FFFF"
          },
          "attribute": {
            "color": "#00CED1"
          },
          "property": {
            "color": "#00CED1"
          },
          "punctuation": {
            "color": "#9D8FBD"
          },
          "invalid": {
            "color": "#FFFFFF"
          }
        }
      }
    }
  ]
}
