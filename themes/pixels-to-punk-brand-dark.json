        "border.selected": "#FF1493",
        "border.variant": "#2D1B4E",
        "element.background": "#251845",
        "element.hover": "#251845",
        "element.active": "#3D2B5E",
        "element.selected": "#3D2B5E",
        "element.disabled": "#1F1535",
        "ghost_element.hover": "#251845",
        "ghost_element.active": "#3D2B5E",
        "ghost_element.selected": "#1F1535",
        "text.muted": "#9D8FBD",
        "text.placeholder": "#7B6FA6",
        "text.accent": "#FF1493",
        "icon.muted": "#6A5ACD",
        "surface.background": "#16052A",
        "panel.background": "#16052A",
        "panel.focused_border": "#3D2B5E",
        "elevated_surface.background": "#1F1535",
        "drop_target.background": "#FF149355",
        "status_bar.background": "#16052A",
        "title_bar.background": "#16052A",
        "title_bar.inactive_background": "#1a0a2e",
        "toolbar.background": "#16052A",
        "tab_bar.background": "#16052A",
        "tab.active_background": "#1a0a2e",
        "tab.inactive_background": "#16052A",
        "scrollbar.thumb.background": "#6A5ACD77",
        "scrollbar.thumb.hover_background": "#FF1493AA",
        "scrollbar.thumb.border": "#6A5ACD77",
        "scrollbar.track.background": "#1a0a2e",
        "scrollbar.track.border": "#1a0a2e",
        "terminal.background": "#1a0a2e",
        "terminal.foreground": "#E8E8FF",
        "terminal.ansi.black": "#867E92",
        "terminal.ansi.red": "#FF6347",
        "terminal.ansi.green": "#00FF41",
        "terminal.ansi.yellow": "#FFD700",
        "terminal.ansi.blue": "#1A2DFF",
        "terminal.ansi.magenta": "#FF1493",
        "terminal.ansi.cyan": "#00FFFF",
        "terminal.ansi.white": "#E8E8FF",
        "terminal.ansi.bright_black": "#8173DA",
        "terminal.ansi.bright_red": "#FF7361",
        "terminal.ansi.bright_green": "#00FF7F",
        "terminal.ansi.bright_yellow": "#FFED4E",
        "terminal.ansi.bright_blue": "#4D5BFF",
        "terminal.ansi.bright_magenta": "#FF69B4",
        "terminal.ansi.bright_cyan": "#00FFFF",
        "terminal.ansi.bright_white": "#FFFFFF",
        "players": [
          {
            "cursor": "#FF1493",
            "selection": "#FF149355",
            "background": "#FF1493"
