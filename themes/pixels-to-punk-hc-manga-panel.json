        "icon.muted": "#4C4C4C",
        "surface.background": "#E2E2E2",
        "panel.background": "#E2E2E2",
        "panel.focused_border": "#BDBDBD",
        "elevated_surface.background": "#FFFFFF",
        "drop_target.background": "#B0002D24",
        "status_bar.background": "#E2E2E2",
        "title_bar.background": "#E2E2E2",
