        "editor.document_highlight.read_background": "#005C7530",
        "editor.document_highlight.write_background": "#B0002D2E",
        "search.match_background": "#70490055",
        "error": "#C40028",
        "warning": "#704900",
        "info": "#005C75",
        "hint": "#005C75",
        "success": "#315F00",
        "created": "#315F00",
