        "terminal.foreground": "#050505",
        "terminal.ansi.black": "#050505",
        "terminal.ansi.red": "#C40028",
        "terminal.ansi.green": "#315F00",
        "terminal.ansi.yellow": "#704900",
        "terminal.ansi.blue": "#004CC0",
        "terminal.ansi.magenta": "#B0002D",
        "terminal.ansi.cyan": "#005C75",
        "terminal.ansi.white": "#050505",
        "terminal.ansi.bright_black": "#4C4C4C",
        "terminal.ansi.bright_red": "#C40028",
        "terminal.ansi.bright_green": "#315F00",
        "terminal.ansi.bright_yellow": "#704900",
        "terminal.ansi.bright_blue": "#004CC0",
        "terminal.ansi.bright_magenta": "#B0002D",
        "terminal.ansi.bright_cyan": "#005C75",
        "terminal.ansi.bright_white": "#4C4C4C",
