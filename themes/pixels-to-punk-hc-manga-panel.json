          },
          "number": {
            "color": "#704900"
          },
          "boolean": {
            "color": "#704900"
          },
          "constant": {
            "color": "#704900"
          },
          "keyword": {
            "color": "#B0002D"
          },
          "function": {
            "color": "#005C75"
          },
          "variable": {
            "color": "#050505"
          },
          "variable.special": {
            "color": "#315F00"
          },
          "type": {
            "color": "#42308C"
          },
          "attribute": {
            "color": "#004CC0"
          },
          "property": {
            "color": "#004CC0"
          },
          "punctuation": {
            "color": "#202020"
          },
          "invalid": {
            "color": "#FFFFFF"
          }
        }
