{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Pixels to Punk",
  "author": "Ryan McDonald",
  "themes": [
    {
      "name": "Pixels to Punk HC Manga Panel",
      "appearance": "light",
      "style": {
        "background": "#FAFAFA",
        "text": "#050505",
        "editor.background": "#FAFAFA",
        "editor.foreground": "#050505",
        "editor.line_number": "#4C4C4C",
        "editor.active_line_number": "#005C75",
        "editor.active_line.background": "#ECECEC",
        "editor.gutter.background": "#FAFAFA",
